# Delivery packages, prototype renders, and private source media are local build
# state. Each owning pipeline also ignores its own cache; this root catches the
# shared orchestration scratch used by deliver.py and one-off rehearsals.
.work/
.asset-cache/
.wrangler/
.DS_Store
__pycache__/
*.py[cod]
*.egg-info/
.limen-workstream/
.worktrees/
