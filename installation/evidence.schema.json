{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://organvm.dev/danse/installation/evidence.schema.json",
  "title": "Danse venue-owned installation evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evidence_id",
    "spec_contract_sha256",
    "venue",
    "geometry",
    "release",
    "hardware",
    "calibration",
    "runtime",
    "wall_plug_proofs",
    "restore_rehearsal"
  ],
  "properties": {
    "schema": {"const": "danse.installation.evidence.v2"},
    "evidence_id": {"type": "string", "minLength": 1},
    "spec_contract_sha256": {"$ref": "#/$defs/sha256"},
    "venue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "approved",
        "approved_by",
        "approved_at",
        "approval_receipt_sha256",
        "dimensions_m",
        "egress_approved",
        "mounting_approved",
        "power_approved",
        "ventilation_approved",
        "safety_receipt_sha256"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "approved": {"type": "boolean"},
        "approved_by": {"type": "string", "minLength": 1},
        "approved_at": {"$ref": "#/$defs/timestamp"},
        "approval_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "dimensions_m": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height", "depth"],
          "properties": {
            "width": {"type": "number", "exclusiveMinimum": 0},
            "height": {"type": "number", "exclusiveMinimum": 0},
            "depth": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "egress_approved": {"type": "boolean"},
        "mounting_approved": {"type": "boolean"},
        "power_approved": {"type": "boolean"},
        "ventilation_approved": {"type": "boolean"},
        "safety_receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surfaces", "projectors", "receipt_sha256"],
      "properties": {
        "surfaces": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reference_surface", "hardware_role", "center_m", "rotation_radians", "size_m", "measurement_receipt_sha256"],
            "properties": {
              "reference_surface": {"type": "string", "minLength": 1},
              "hardware_role": {"type": "string", "minLength": 1},
              "center_m": {"$ref": "#/$defs/vector3"},
              "rotation_radians": {"$ref": "#/$defs/vector3"},
              "size_m": {"$ref": "#/$defs/vector2_positive"},
              "measurement_receipt_sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        },
        "projectors": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["output", "hardware_role", "surface", "position_m", "aim_point_m", "throw_distance_m", "resolution_px", "refresh_hz", "lens_receipt_sha256"],
            "properties": {
              "output": {"type": "string", "minLength": 1},
              "hardware_role": {"type": "string", "minLength": 1},
              "surface": {"type": "string", "minLength": 1},
              "position_m": {"$ref": "#/$defs/vector3"},
              "aim_point_m": {"$ref": "#/$defs/vector3"},
              "throw_distance_m": {"type": "number", "exclusiveMinimum": 0},
              "resolution_px": {
                "type": "array",
                "prefixItems": [
                  {"type": "integer", "minimum": 1},
                  {"type": "integer", "minimum": 1}
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "refresh_hz": {"type": "number", "exclusiveMinimum": 0},
              "lens_receipt_sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        },
        "receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_kind", "manifest_path", "manifest_sha256", "developer_checkout"],
      "properties": {
        "root_kind": {"const": "canonical-release"},
        "manifest_path": {"const": "release-manifest.json"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "developer_checkout": {"const": false}
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assets", "cabling_receipt_sha256", "power_receipt_sha256", "ventilation_receipt_sha256"],
      "properties": {
        "assets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "asset_id", "verified", "receipt_sha256"],
            "properties": {
              "role": {"type": "string", "minLength": 1},
              "asset_id": {"type": "string", "minLength": 1},
              "verified": {"type": "boolean"},
              "receipt_sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        },
        "cabling_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "power_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "ventilation_receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spec_contract_sha256",
        "projector_registration_error_px",
        "output_skew_ms",
        "audio_visual_skew_ms",
        "speaker_route_errors",
        "limiter_ceiling_dbfs",
        "visible_plane_cue",
        "receipt_sha256"
      ],
      "properties": {
        "spec_contract_sha256": {"$ref": "#/$defs/sha256"},
        "projector_registration_error_px": {"type": "number", "minimum": 0},
        "output_skew_ms": {"type": "number", "minimum": 0},
        "audio_visual_skew_ms": {"type": "number", "minimum": 0},
        "speaker_route_errors": {"type": "integer", "minimum": 0},
        "limiter_ceiling_dbfs": {"type": "number", "maximum": 0},
        "visible_plane_cue": {"$ref": "#/$defs/human_pass"},
        "receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved", "approved_by", "approval_receipt_sha256", "argv", "argv_sha256", "health_url", "river"],
      "properties": {
        "approved": {"type": "boolean"},
        "approved_by": {"type": "string", "minLength": 1},
        "approval_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "argv_sha256": {"$ref": "#/$defs/sha256"},
        "health_url": {"type": ["string", "null"]},
        "river": {
          "type": "object",
          "additionalProperties": false,
          "required": ["seed", "stream", "epoch_ms"],
          "properties": {
            "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
            "stream": {"type": "integer", "minimum": 0, "maximum": 4294967295},
            "epoch_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
          }
        }
      }
    },
    "wall_plug_proofs": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/wall_plug_proof"}},
    "restore_rehearsal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "setup_passed",
        "strike_passed",
        "restore_passed",
        "canonical_release_restored",
        "observer",
        "observed_at",
        "setup_receipt_sha256",
        "strike_receipt_sha256",
        "restore_receipt_sha256",
        "configuration_sha256"
      ],
      "properties": {
        "setup_passed": {"type": "boolean"},
        "strike_passed": {"type": "boolean"},
        "restore_passed": {"type": "boolean"},
        "canonical_release_restored": {"type": "boolean"},
        "observer": {
          "anyOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "observed_at": {
          "anyOf": [
            {"$ref": "#/$defs/timestamp"},
            {"type": "null"}
          ]
        },
        "setup_receipt_sha256": {
          "anyOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "strike_receipt_sha256": {
          "anyOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "restore_receipt_sha256": {
          "anyOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "configuration_sha256": {
          "anyOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?!0000)[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:0[48]|[2468][048]|[13579][26])00)-02-29)T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
    },
    "vector3": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "vector2_positive": {
      "type": "array",
      "prefixItems": [
        {"type": "number", "exclusiveMinimum": 0},
        {"type": "number", "exclusiveMinimum": 0}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "human_pass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "observer", "observed_at", "receipt_sha256"],
      "properties": {
        "passed": {"type": "boolean"},
        "observer": {"type": "string", "minLength": 1},
        "observed_at": {"$ref": "#/$defs/timestamp"},
        "receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "wall_plug_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "observer",
        "observed_at",
        "power_removed_seconds",
        "returned_to_display_seconds",
        "generative_display_returned",
        "manual_repair_required",
        "spec_contract_sha256",
        "configuration_sha256",
        "runtime_telemetry_receipt",
        "runtime_telemetry_sha256",
        "receipt_sha256"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "observer": {"type": "string", "minLength": 1},
        "observed_at": {"$ref": "#/$defs/timestamp"},
        "power_removed_seconds": {"type": "number", "minimum": 1},
        "returned_to_display_seconds": {"type": "number", "minimum": 0},
        "generative_display_returned": {"type": "boolean"},
        "manual_repair_required": {"type": "boolean"},
        "spec_contract_sha256": {"$ref": "#/$defs/sha256"},
        "configuration_sha256": {"$ref": "#/$defs/sha256"},
        "runtime_telemetry_receipt": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "evidence_id",
            "proof_id",
            "spec_contract_sha256",
            "configuration_sha256",
            "events_sha256",
            "events_jsonl"
          ],
          "properties": {
            "schema": {"const": "danse.installation.runtime-telemetry-receipt.v2"},
            "evidence_id": {"type": "string", "minLength": 1},
            "proof_id": {"type": "string", "minLength": 1},
            "spec_contract_sha256": {"$ref": "#/$defs/sha256"},
            "configuration_sha256": {"$ref": "#/$defs/sha256"},
            "events_sha256": {"$ref": "#/$defs/sha256"},
            "events_jsonl": {"type": "string", "minLength": 1, "maxLength": 1048576}
          }
        },
        "runtime_telemetry_sha256": {"$ref": "#/$defs/sha256"},
        "receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
