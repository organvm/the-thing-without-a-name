{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://organvm.github.io/the-thing-without-a-name/assets/lock.schema.json",
  "title": "Danse immutable asset lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "lock_id", "profile", "repository_commit", "assets"],
  "properties": {
    "schema": {"const": "danse.assets.lock.v1"},
    "lock_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"},
    "profile": {"enum": ["generic", "screendance-production"]},
    "repository_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/asset"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!\\.git(?:/|$))(?!\\.asset-cache(?:/|$))(?!.*(?:^|/)\\.\\.?(/|$))(?!.*\\\\).+$"
    },
    "httpsSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "url"],
      "properties": {
        "kind": {"const": "https"},
        "url": {
          "type": "string",
          "pattern": "^https://(?!localhost(?:[:/]|$))(?![^/?#@]*@)[A-Za-z0-9.-]+(?::443)?(?:/[^?#]*)?$"
        }
      }
    },
    "fileSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {
        "kind": {"const": "file"},
        "path": {"$ref": "#/$defs/path"}
      }
    },
    "githubReleaseSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repository", "tag", "asset"],
      "properties": {
        "kind": {"const": "github-release"},
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "tag": {"type": "string", "pattern": "^[^\\r\\n\\u0000]+$"},
        "asset": {"type": "string", "pattern": "^[^/\\\\\\r\\n\\u0000]+$"},
        "token_env": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "sha256", "bytes", "media_type", "rights_class", "required", "sources"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"},
        "target": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0},
        "media_type": {"type": "string", "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+$"},
        "rights_class": {"enum": ["public", "restricted", "private"]},
        "required": {"type": "boolean"},
        "sources": {
          "type": "array",
          "items": {
            "oneOf": [
              {"$ref": "#/$defs/httpsSource"},
              {"$ref": "#/$defs/fileSource"},
              {"$ref": "#/$defs/githubReleaseSource"}
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"required": {"const": true}}},
          "then": {"properties": {"sources": {"minItems": 1}}}
        }
      ]
    }
  }
}
